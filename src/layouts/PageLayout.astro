---
import '../styles/global.css';
const { frontmatter } = Astro.props;
const site = 'https://donschuy.com/';
---
<html lang="en">
  <head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/icons8-tree-pulsar-color-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

    {frontmatter.title && (
      <meta property="og:title" content={frontmatter.title} />
    )}
    {frontmatter.description && (
      <meta property="og:description" content={frontmatter.description} />
    )}
    {frontmatter.pageUrl && (
      <meta property="og:url" content={site + frontmatter.pageUrl} />
    )}
    <meta property="og:type" content="website" />
    {frontmatter.preview && (
      <meta property="og:image" content={site + frontmatter.preview} />
      <meta property="og:image:secure_url" content={site + frontmatter.preview} />
      <meta property="og:image:type" content="image/webp" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="627" />
    )}
    {frontmatter.preview && frontmatter.previewAltText && (
      <meta property="og:image:alt" content={frontmatter.preview_alt} />
    )}

    <title>Don Schuy's Activity Book</title>
  </head>
  <body class="page">
    <nav>
      <a href="/">Home</a>
      <a href="/about">About</a>
    </nav>
    <article>
      <slot />
    </article>
    <nav>
      <a href="/">Home</a>
    </nav>
    <footer>
      <div>© 2026 Don Schuy. All rights reserved.</div>
    </footer>
  </body>
</html>