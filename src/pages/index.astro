---
import '../styles/common.css';
import '../styles/index.css';
import data from './index.json';
const articles = data.articles;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/icons8-tree-pulsar-color-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Don Schuy's Activity Book</title>
	</head>
	<body class="home">
		<h1>Don Schuy's Activity Book</h1>
    <nav>
      <a href="/about">About</a>
      <a href="/subscribe-form">Subscribe</a>
    </nav>

    <nav>
      {articles.map(article => (
        <li class="card">
          <a href={article.href}>{article.title}
            {article.preview &&
              <div><img src={article.preview} /></div>
            }
            <div class="entry-date">{article["entry-date"]}</div>
          </a>
        </li>
      ))}
    </nav>
  </body>
</html>